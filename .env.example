DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DATABASE_POOL_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?sslmode=require&pgbouncer=true"
DB_POOL_MAX="3"
DB_IDLE_TIMEOUT_MS="10000"
DB_CONNECTION_TIMEOUT_MS="10000"

# Public app origin used for signed payment callbacks and origin checks.
APP_URL="https://comfihealth.com"
NEXT_PUBLIC_APP_URL="https://comfihealth.com"
ALLOWED_ORIGINS="https://comfihealth.com"

# Set true only when your host/proxy strips spoofed forwarding headers.
RATE_LIMIT_TRUST_PROXY_HEADERS="false"

# Hexclave / Stack Auth
NEXT_PUBLIC_STACK_PROJECT_ID="your-stack-project-id"
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY="your-stack-publishable-client-key"
STACK_SECRET_SERVER_KEY="your-stack-secret-server-key"

# Comma-separated allowlists. Required in production for dashboard/inventory access.
ADMIN_USER_IDS="stack-user-id-1,stack-user-id-2"
ADMIN_EMAILS="admin@example.com"

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_replace_me"
PAYSTACK_SECRET_KEY="sk_test_replace_me"
# Required in production (must differ from PAYSTACK_SECRET_KEY).
ORDER_RECEIPT_SECRET="generate-a-long-random-secret"

# Upstash Redis (recommended in production for distributed rate limiting)
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# S3-compatible object storage for product images (R2, AWS S3, MinIO)
S3_BUCKET="your-bucket"
S3_REGION="auto"
S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_PUBLIC_URL="https://cdn.example.com"
# S3_FORCE_PATH_STYLE="true"

# Transactional email (Resend)
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="Comfi Health <orders@comfihealth.com>"
