DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full"
DATABASE_POOL_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?sslmode=verify-full&pgbouncer=true"
DB_POOL_MAX="3"
DB_IDLE_TIMEOUT_MS="10000"
DB_CONNECTION_TIMEOUT_MS="60000"


# Public app origin used for signed payment callbacks and origin checks.
APP_URL="https://comfihealth.com"
NEXT_PUBLIC_APP_URL="https://comfihealth.com"
ALLOWED_ORIGINS="https://comfihealth.com"
# Optional extra hosts in local development when testing from a phone/tablet on your LAN.
# Common private LAN hosts (10.*, 172.*, 192.168.*) are already allowed by next.config.ts.
ALLOWED_DEV_ORIGINS=""

# Set true only when your host/proxy strips spoofed forwarding headers.
RATE_LIMIT_TRUST_PROXY_HEADERS="false"

# Hexclave / Stack Auth
NEXT_PUBLIC_STACK_PROJECT_ID="gentle-block-73579466"
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY="your-stack-publishable-client-key"
STACK_SECRET_SERVER_KEY="your-stack-secret-server-key"

# Comma-separated allowlists. Required in production for dashboard/inventory access.
ADMIN_USER_IDS="2eba823f-23db-40c0-84ef-9d34bdb09cb0"
ADMIN_EMAILS="gbennerth@gmail.com"


# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_replace_me"
PAYSTACK_SECRET_KEY="sk_test_replace_me"
# Required in production (must differ from PAYSTACK_SECRET_KEY).
ORDER_RECEIPT_SECRET="generate-a-long-random-secret"

# Groq AI health guide
GROQ_API_KEY="your-groq-api-key"

# Upstash Redis (recommended in production for distributed rate limiting)
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# S3-compatible object storage for product images (R2, AWS S3, MinIO)
S3_BUCKET="your-bucket"
S3_REGION="auto"
S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_PUBLIC_URL="https://cdn.example.com"
# S3_FORCE_PATH_STYLE="true"

# Transactional email (Resend — resend.com, free tier = 3 000 emails/month)
# Also verify your domain in the Resend dashboard and add the DNS records.
RESEND_API_KEY="re_replace_me"
EMAIL_FROM="Comfi Health <noreply@your-domain.com>"
# These two are used by lib/notifications.ts for the admin order email:
FROM_EMAIL="orders@comforthealth.com"
ADMIN_EMAIL="support@comforthealth.com"

# WhatsApp order notifications via CallMeBot (completely free)
# Setup: save +34 644 61 95 93 on your phone and send it "I allow callmebot to send me messages"
# CallMeBot replies instantly with your personal API key.
ADMIN_WHATSAPP="233XXXXXXXXX"
CALLMEBOT_API_KEY="your_callmebot_key_here"
NEXT_PUBLIC_PHARMACY_PHONE="0537355068"
NEXT_PUBLIC_PHARMACY_SECONDARY_PHONE="0205295130"
# Rider WhatsApp (repeat the CallMeBot activation for the rider's number)
RIDER_WHATSAPP="233XXXXXXXXX"
RIDER_CALLMEBOT_KEY="rider_callmebot_key_here"

# Real-time dashboard SSE polling interval in milliseconds (default 6000 = 6 s)
NEXT_PUBLIC_POLL_INTERVAL="6000"
