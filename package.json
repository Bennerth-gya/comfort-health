{
  "name": "comfi",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--dns-result-order=ipv4first' next dev --turbopack --hostname 0.0.0.0",
    "build": "prisma generate && prisma db push && next build",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "start": "next start --hostname 0.0.0.0",
    "lint": "next lint",
    "analyze": "ANALYZE=true next build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1056.0",
    "@better-auth/infra": "^0.2.13",
    "@paystack/inline-js": "^2.22.9",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.8.0",
    "@stackframe/stack": "^2.8.108",
    "@stackframe/stack-ui": "^2.8.108",
    "@supabase/server": "^1.4.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "groq-sdk": "^1.3.0",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "next-cloudinary": "^6.18.8",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@stackframe/stack": {
      "lucide-react": "$lucide-react"
    },
    "@stackframe/stack-ui": {
      "lucide-react": "$lucide-react"
    }
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.10",
    "@next/env": "16.2.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.9.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.1",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
