// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/db"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model User {
  id        String   @id // Stack user ID
  email     String?
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email])
  @@map("users")
}

model Product {
  id     String @id @default(cuid())
  userId String

  name         String
  description  String?
  category     String?
  sku          String?   @unique
  price        Decimal   @db.Decimal(12, 2)
  quantity     Int       @default(0)
  lowStock     Int?
  dosage       String?
  dosageGuide  Json?
  manufacturer String?
  expiryDate   DateTime?
  imageUrl     String?

  prescriptionRequired Boolean @default(false)
  activeListing        Boolean @default(true)

  isFeatured   Boolean  @default(false)
  featuredRank Int?
  createAt     DateTime @default(now())
  updateAt     DateTime @updatedAt

  orderItems OrderItem[]

  @@index([userId, createAt])
  @@index([activeListing, createAt])
  @@index([userId, activeListing, createAt])
  @@index([userId, category])
  @@index([userId, manufacturer])
  @@index([userId, price])
  @@map("product")
}

model Order {
  id             String    @id @default(cuid())
  reference      String    @unique
  idempotencyKey String?   @unique
  sellerId       String?
  email          String
  amount         Decimal   @db.Decimal(12, 2)
  currency       String    @default("GHS")
  status         String    @default("pending")
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  fulfillmentStatus OrderStatus @default(PENDING)
  customerName      String?
  customerPhone     String?
  customerAddress   String?
  riderId           String?
  riderName         String?
  riderPhone        String?
  assignedAt        DateTime?
  pickedUpAt        DateTime?
  deliveredAt       DateTime?
  estimatedTime     Int?
  adminNotes        String?
  notificationSent  Boolean     @default(false)

  items         OrderItem[]
  payment       PaymentTransaction?
  statusHistory OrderStatusLog[]
  rider         Rider?              @relation(fields: [riderId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([sellerId, createdAt])
  @@index([sellerId, status, createdAt])
  @@index([status, createdAt])
  @@index([fulfillmentStatus, createdAt])
  @@map("orders")
}

model OrderStatusLog {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_log")
}

model Rider {
  id        String   @id @default(cuid())
  name      String
  phone     String
  whatsapp  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  orders Order[]

  @@map("riders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  unitPrice Decimal @db.Decimal(12, 2)
  quantity  Int
  lineTotal Decimal @db.Decimal(12, 2)
  imageUrl  String?
  category  String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_item")
}

model PaymentTransaction {
  id                String    @id @default(cuid())
  orderId           String    @unique
  reference         String    @unique
  provider          String    @default("paystack")
  providerReference String?
  authorizationUrl  String?
  accessCode        String?
  status            String    @default("pending")
  amount            Decimal   @db.Decimal(12, 2)
  currency          String    @default("GHS")
  paidAt            DateTime?
  rawPayload        Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("payment_transaction")
}

model HeroSlide {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  ctaText   String?
  ctaUrl    String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Pharmacist Consultation Chat ─────────────────────────────────────────────

enum ConversationStatus {
  WAITING
  ACTIVE
  RESOLVED
  CLOSED
}

enum SenderType {
  STUDENT
  PHARMACIST
  SYSTEM
}

enum MessageType {
  TEXT
  PRODUCT_RECOMMENDATION
  SYSTEM_NOTICE
}

model SupportConversation {
  id           String             @id @default(cuid())
  userId       String?
  guestName    String?
  guestPhone   String?
  status       ConversationStatus @default(WAITING)
  subject      String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  lastMessageAt DateTime          @default(now())
  pharmacistId String?
  isRead       Boolean            @default(false)
  messages     SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([lastMessageAt])
  @@map("support_conversation")
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  content        String
  senderType     SenderType
  senderName     String
  createdAt      DateTime            @default(now())
  isRead         Boolean             @default(false)
  messageType    MessageType         @default(TEXT)
  productId      String?
  productName    String?
  productPrice   Float?
  productImage   String?

  @@index([conversationId, createdAt])
  @@map("support_message")
}

model CustomerReview {
  id          String   @id @default(cuid())
  name        String
  rating      Int      // 1 to 5 stars
  message     String   @db.Text
  isApproved  Boolean  @default(false)
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductRequest {
  id          String              @id @default(cuid())
  name        String              // customer name
  productName String              // what they want
  reason      String?             @db.Text // why they want it
  status      ProductRequestStatus @default(PENDING)
  isRead      Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

enum ProductRequestStatus {
  PENDING
  NOTED
  ADDED
  UNAVAILABLE
}
